# Backend (Netlify Functions). Set these in Netlify → Site configuration → Environment variables,
# or in a local .env for `npm run api:dev`.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5          # brain for discovery / classification / navigation
AGENT_EFFORT=high                  # low | medium | high | xhigh | max
WALKAWAY_BRAIN=                    # leave empty (claude when a key exists), or "mock" for rule-based testing
WALKAWAY_CLIENT_KEY=               # optional shared secret; the extension sends it as x-walkaway-key
