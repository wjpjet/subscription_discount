# Backend. On Cloudflare Workers: `npx wrangler secret put <NAME>` for secrets, `vars` in
# wrangler.jsonc for the rest, and a gitignored .dev.vars for `npm run cf:dev`.
# On Netlify: Site configuration → Environment variables. Locally: a .env for `npm run api:dev`.

# --- AI brain: set one or both keys. AI_PROVIDER picks the order, e.g. "gemini,anthropic" ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5        # or claude-sonnet-5 / claude-haiku-4-5
AGENT_EFFORT=medium              # low | medium | high (higher = slower)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash    # navigation steps
GEMINI_MODEL_FAST=gemini-3.1-flash-lite   # classify/discover (default); steps stay on GEMINI_MODEL
GEMINI_THINKING_STEP=default     # keep 'default' — thinking is what wins the hard scenarios (see HISTORY.md)
GEMINI_THINKING_FAST=off         # thinking for classify/discover (they don't need it)
# --- Any OpenAI-compatible endpoint (provider id "openai"): GLM via Z.ai, Together, Fireworks,
#     Baseten, DeepInfra, OpenRouter, ... Set AI_PROVIDER=openai to use it for the navigation steps.
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # Z.ai https://api.z.ai/api/paas/v4 | Together https://api.together.xyz/v1
                                 # | Fireworks https://api.fireworks.ai/inference/v1
OPENAI_MODEL=                    # e.g. glm-5.3-flash (Z.ai) | zai-org/GLM-5.3-Flash (Together/DeepInfra)
OPENAI_MODEL_FAST=               # classify/discover; defaults to OPENAI_MODEL
OPENAI_THINKING_STEP=low         # GLM-5.3-Flash CANNOT turn thinking off and defaults to "max" —
                                 # leave this at low or it is slow and expensive. low | high | max
OPENAI_THINKING_FAST=off         # degrades to the cheapest the model accepts

PRICE_IN=                        # optional: your model's $/1M input tokens, for the suite's cost line
PRICE_OUT=                       # optional: $/1M output tokens (thinking bills as output)
AI_PROVIDER=                     # empty = Gemini first if its key exists, then Anthropic; or set explicitly
WALKAWAY_BRAIN=                  # empty = real AI; "mock" = rule-based test brain

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=               # sk_test_... to start (NEVER commit the real .env)
STRIPE_PUBLISHABLE_KEY=          # pk_test_... (not used by the backend yet)
SITE_URL=                        # e.g. https://your-site.netlify.app (defaults to the request host)

# --- Abuse controls ---
WALKAWAY_CLIENT_KEY=             # optional shared secret; the extension sends it as x-walkaway-key
WALKAWAY_RATE_LIMIT=300          # requests per minute per IP on the backend (0 = off)
