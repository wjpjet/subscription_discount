# Backend (Netlify Functions). Set in Netlify → Site configuration → Environment variables,
# or in a local .env / shell for `npm run api:dev`.

# --- AI brain: set one or both keys. AI_PROVIDER picks the order, e.g. "gemini,anthropic" ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5        # or claude-sonnet-5 / claude-haiku-4-5
AGENT_EFFORT=medium              # low | medium | high (higher = slower; Netlify functions time out at ~10s)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash    # paste the current Flash model id from AI Studio
AI_PROVIDER=                     # empty = whichever keys exist (anthropic first); "gemini" = Gemini only
WALKAWAY_BRAIN=                  # empty = real AI; "mock" = rule-based test brain

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=               # sk_test_... to start
SITE_URL=                        # e.g. https://your-site.netlify.app (defaults to the request host)

# --- Abuse controls ---
WALKAWAY_CLIENT_KEY=             # optional shared secret; the extension sends it as x-walkaway-key
