# Backend (Netlify Functions). Set in Netlify → Site configuration → Environment variables,
# or in a local .env / shell for `npm run api:dev`.

# --- AI brain: set one or both keys. AI_PROVIDER picks the order, e.g. "gemini,anthropic" ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5        # or claude-sonnet-5 / claude-haiku-4-5
AGENT_EFFORT=medium              # low | medium | high (higher = slower; Netlify functions time out at ~10s)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash    # navigation steps
GEMINI_MODEL_FAST=               # classify/discover model, e.g. gemini-3.5-flash-lite (default: same as GEMINI_MODEL)
GEMINI_THINKING_STEP=default     # default | off | low | medium | high | <token budget>  (steps)
GEMINI_THINKING_FAST=off         # thinking for classify/discover (they don't need it)
PRICE_IN=                        # optional: your model's $/1M input tokens, for the suite's cost line
PRICE_OUT=                       # optional: $/1M output tokens (thinking bills as output)
AI_PROVIDER=                     # empty = Gemini first if its key exists, then Anthropic; or set explicitly
WALKAWAY_BRAIN=                  # empty = real AI; "mock" = rule-based test brain

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=               # sk_test_... to start (NEVER commit the real .env)
STRIPE_PUBLISHABLE_KEY=          # pk_test_... (not used by the backend yet)
SITE_URL=                        # e.g. https://your-site.netlify.app (defaults to the request host)

# --- Abuse controls ---
WALKAWAY_CLIENT_KEY=             # optional shared secret; the extension sends it as x-walkaway-key
