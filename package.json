    "test:stripe": "node --env-file-if-exists=.env scripts/test-stripe.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "models": "node --env-file-if-exists=.env scripts/list-models.mjs",
    "latency": "node --env-file-if-exists=.env scripts/latency.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail",
    "verify": "node --env-file-if-exists=.env scripts/verify-worker.mjs",
