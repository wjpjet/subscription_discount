    "test:scrub": "node scripts/test-scrub.mjs",
    "test:reader": "node scripts/test-page-reader.mjs",
    "test": "npm run test:sensitive && npm run test:guardrails && npm run test:scrub && npm run test:saving && npm run test:reader && npm run test:hunt && npm run test:scan",
