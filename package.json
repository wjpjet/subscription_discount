    "test:scan": "node scripts/test-scan.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "stripe": "^17.0.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
