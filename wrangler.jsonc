{
  // Cloudflare Worker: the API and the landing page in one deploy.
  //
  //   npx wrangler dev           local, on the real runtime (workerd), port 8787
  //   npx wrangler deploy        publish
  //   npx wrangler tail          live logs
  //
  // Secrets are NOT listed here — they would be plaintext in git. Set them once with:
  //   npx wrangler secret put GEMINI_API_KEY
  //   npx wrangler secret put STRIPE_SECRET_KEY
  //   npx wrangler secret put OPENAI_API_KEY        (only if testing an OpenAI-compatible model)
  // For local dev, put the same names in .dev.vars (gitignored).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "walkaway",
  "main": "worker/index.mjs",
  // The free <name>.<account>.workers.dev URL is the public address until a custom domain exists.
  // Preview URLs would expose every uploaded version at its own public URL; off until needed.
  "workers_dev": true,
  "preview_urls": false,

  // >= 2025-04-01 is what makes process.env populated from vars and secrets, including at module
  // scope. nodejs_compat is what lets the Anthropic and Stripe SDKs resolve their node/workerd builds.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Plain (non-secret) config. Secrets never go here.
  //   AI_PROVIDER pins the brain to Gemini. Without it, providerOrder() picks whichever key exists,
  //   so adding an OPENAI_API_KEY secret later (to A/B another model) would silently take over
  //   production. With it, other keys are inert until you change this line.
  //   No SITE_URL on purpose: Stripe's return URLs fall back to the host the request arrived on, so a
  //   fresh deploy redirects to its own workers.dev URL. Add SITE_URL only for a custom domain.
  "vars": {
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_MODEL_FAST": "gemini-3.1-flash-lite"
  },

  // Static assets are served directly and are FREE and unlimited; only /api/* invokes the Worker.
  // Without run_worker_first an asset would shadow an API route of the same name.
  "assets": {
    "directory": "./landing/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // No CPU limit set: the Free plan rejects the field outright. Its fixed ceiling is 10ms of CPU per
  // request (30s on Paid); we measured 0.29ms. Wall clock is unlimited on both plans.

  "observability": { "enabled": true }
}
